<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>자유게시판</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.2/css/bootstrap.min.css">
    <link href="/stylesheet/main.css" rel="stylesheet" type="text/css">
  </head>
  <body>
    <nav class="navbar navbar-inverse sidebar" role="navigation">
      <div class="container-fluid">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
              <span class="sr-only">Toggle navigation</span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
            </button>
            <h3><p class="text-center"><a href="/board_list" class="text-muted nounderline">스터디 게시판</a></p></h3>
        </div>
        <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
          <ul class="nav navbar-nav">
            <br>
              <li ><a href="/board_list">자유게시판<span style="font-size:16px;" class="pull-right hidden-xs showopacity glyphicon glyphicon-th-list"></span></a></li>
              <% if (userId) { %>
                <li ><a href="/logout">로그아웃<span style="font-size:16px;" class="pull-right hidden-xs showopacity glyphicon glyphicon-log-out"></span></a></li>
              <% } else { %>
                <li ><a href="/login">로그인<span style="font-size:16px;" class="pull-right hidden-xs showopacity glyphicon glyphicon-log-in"></span></a></li>
              <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="main">
      <div class="main2">
      <a href="/board_write" class="btn btn-success pull-right"><span class="pull-left showopacity glyphicon glyphicon-pencil"></span>새 글 쓰기</a>

      <h4><strong>자유게시판</strong></h4>

        <div class="col-md-4 col-xs-6 pull-right">
          <form action="/board_search" method="get">
          <div class="input-group">
            <input name="boardSearch" type="text" class="form-control"  placeholder="검색어를 입력해주세요" value="<%= typeof boardSearch !== 'undefined' ? boardSearch : '' %>">
            <div class="input-group-btn">
              <button class="btn btn-default" type="submit"><i class="glyphicon glyphicon-search"></i></button>
            </div>
          </div>
        </form>
        </div>
      </div>

      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>번호</th>
            <th>제목</th>
            <th>작성자</th>
            <th>작성일</th>
            <th>조회수</th>
            <th>댓글</th>
          </tr>
        </thead>
        <tbody>
          <% for (var i = 0; i < rows.length; i++) { %>
          <tr onclick="location.href='/board_view/<%=rows[i].post_num%>'">
            <td><%=rows[i].post_num%></td>
            <td><%=rows[i].post_title%></td>
            <td><%=rows[i].post_id%></td>
            <td><%=rows[i].post_time%></td>
            <td><%=rows[i].post_hit%></td>
            <td><%=rows[i].comm_count%></td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <div class="text-center">
        <ul class="pagination">
      
          <!-- 이전 버튼 -->
          <li class="<%= currentPage === 1 ? 'disabled' : '' %>">
            <a href="/board_list?page=<%= currentPage - 1 %>&boardSearch=<%= boardSearch %>" aria-label="Previous">
              <span aria-hidden="true">&laquo;</span>
            </a>
          </li>
      
          <!-- 페이지 번호 -->
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="<%= currentPage === i ? 'active' : '' %>">
              <a href="/board_list?page=<%= i %>&boardSearch=<%= boardSearch %>"><%= i %></a>
            </li>
          <% } %>
      
          <!-- 다음 버튼 -->
          <li class="<%= currentPage === totalPages ? 'disabled' : '' %>">
            <a href="/board_list?page=<%= currentPage + 1 %>&boardSearch=<%= boardSearch %>" aria-label="Next">
              <span aria-hidden="true">&raquo;</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.2/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.2/js/bootstrap.min.js"></script>
  </body>
</html>
