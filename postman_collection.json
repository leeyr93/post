        {
          "name": "회원가입 (Join - 성공)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 매 실행 시 중복되지 않는 고유한 ID 및 이메일 동적 생성 (서버 정규식: 영문/숫자 1-10자)",
                  "const uniqueId = 'u' + Date.now().toString().slice(-7);",
                  "const uniqueEmail = uniqueId + '@test.com';",
                  "pm.collectionVariables.set('new_user_id', uniqueId);",
                  "pm.collectionVariables.set('new_user_email', uniqueEmail);",
                  "console.log('🆕 고유한 신규 테스트 계정 생성:', uniqueId, uniqueEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"회원가입 성공 (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    console.log(\"✅ 회원가입 성공! 가입된 ID:\", pm.collectionVariables.get('new_user_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
